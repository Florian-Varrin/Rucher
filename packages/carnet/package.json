{
  "name": "@rucher/carnet",
  "version": "0.2.0-beta.1",
  "description": "Shared state for Rucher: sessions, agents, status and journal in SQLite",
  "keywords": [
    "agents",
    "claude-code",
    "mcp",
    "multi-agent",
    "sqlite"
  ],
  "homepage": "https://github.com/Florian-Varrin/Rucher/tree/master/packages/carnet#readme",
  "bugs": {
    "url": "https://github.com/Florian-Varrin/Rucher/issues"
  },
  "license": "MIT",
  "author": "Florian Varrin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Florian-Varrin/Rucher.git",
    "directory": "packages/carnet"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./mcp": {
      "development": "./src/mcp/index.ts",
      "default": "./dist/mcp.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./mcp": "./dist/mcp.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
